PORT=6108
# On a campus host behind local Nginx, bind only to loopback.
# HOST=127.0.0.1
# Exactly one backend worker/replica until distributed broadcasts are implemented.
WEB_CONCURRENCY=1
ALLOW_PERSONAL_ROOMS=true
NODE_ENV=development
SUPABASE_DB_URL=
# Hosted alternative to a certificate file: paste the complete PEM certificate.
# SUPABASE_DB_CA_CERT=
# Optional downloaded Supabase CA certificate, if required by your connection.
# SUPABASE_DB_CA_FILE=C:/private/supabase-ca.crt
ALLOWED_ORIGINS=http://localhost:3108
FIREBASE_PROJECT_ID=
# Railway alternative to ADC/file credentials: entire service-account JSON, secret.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Use Application Default Credentials on managed hosts, or a private file OUTSIDE this repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-service-account.json
# Empty allows any verified email. Match the frontend policy.
ALLOWED_EMAIL_DOMAINS=vnrvjiet.in
# Set only to the verified number of reverse proxies in front of this service.
# TRUST_PROXY_HOPS=1
# Railway public HTTP ingress automatically uses the edge's X-Real-IP for network limits.
# Temporary diagnostic logs (route/event names and timings only; no tokens/content).
# PERFORMANCE_LOGS=true
