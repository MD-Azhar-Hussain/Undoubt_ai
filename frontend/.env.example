VITE_API_BASE_URL=/api
# Empty uses the current origin (Vite locally, Nginx on campus).
# For separate hosting use the HTTPS backend ORIGIN only, never /be or /api.
VITE_SOCKET_SERVER_URL=
VITE_FRONTEND_URL=http://localhost:3108
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_ALLOWED_EMAIL_DOMAINS=vnrvjiet.in
